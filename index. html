<!DOCTYPE html>
<html lang="am">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ours Cafe - Staff POS & Kitchen Hub</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #070d18; color: #f1f5f9; }
        .kanban-box { background: #111c33; border-radius: 24px; border: 1px solid #1e2f56; }
    </style>
</head>
<body class="p-6">

    <!-- Top Bar -->
    <header class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 pb-5 mb-6 border-b border-slate-800">
        <div class="flex items-center gap-3.5">
            <div class="w-12 h-12 rounded-2xl bg-amber-500 text-slate-950 flex items-center justify-center text-2xl font-black shadow-lg">☕</div>
            <div>
                <h1 class="text-xl font-bold text-white flex items-center gap-2">
                    <span>Ours Cafe</span>
                    <span class="text-xs bg-amber-500/20 text-amber-300 px-2 py-0.5 rounded-md">Live Staff POS</span>
                </h1>
                <p class="text-xs text-emerald-400 font-bold flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span> Google Sheet Live Polling Active (Every 8s)
                </p>
            </div>
        </div>

        <div class="flex items-center gap-2">
            <button onclick="playAlertSound()" class="px-3 py-2 bg-blue-600/30 text-blue-300 rounded-xl text-xs font-bold border border-blue-500/40">
                <i class="fa-solid fa-volume-high mr-1"></i> Sound Test
            </button>
            <button onclick="fetchStaffData()" class="px-3 py-2 bg-emerald-600/30 text-emerald-300 rounded-xl text-xs font-bold border border-emerald-500/40">
                <i class="fa-solid fa-rotate mr-1"></i> አድስ (Sync)
            </button>
        </div>
    </header>

    <!-- Table Matrix Overview -->
    <div class="mb-6">
        <div class="grid grid-cols-6 sm:grid-cols-12 gap-2" id="tableMatrix"></div>
    </div>

    <!-- 4 Stages Kanban -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <!-- New Orders -->
        <div class="kanban-box p-4">
            <div class="flex justify-between items-center mb-4 pb-2 border-b border-slate-800">
                <h3 class="font-bold text-xs text-sky-400 flex items-center gap-1.5 uppercase"><i class="fa-solid fa-inbox"></i> 1. አዲስ ትዕዛዝ</h3>
                <span id="newBadge" class="bg-sky-500/20 text-sky-300 text-xs px-2.5 py-0.5 rounded-full font-bold">0</span>
            </div>
            <div class="space-y-3" id="colNew"></div>
        </div>

        <!-- Cooking / Prep -->
        <div class="kanban-box p-4">
            <div class="flex justify-between items-center mb-4 pb-2 border-b border-slate-800">
                <h3 class="font-bold text-xs text-amber-400 flex items-center gap-1.5 uppercase"><i class="fa-solid fa-fire-burner"></i> 2. በዝግጅት ላይ</h3>
                <span id="prepBadge" class="bg-amber-500/20 text-amber-300 text-xs px-2.5 py-0.5 rounded-full font-bold">0</span>
            </div>
            <div class="space-y-3" id="colKitchen"></div>
        </div>

        <!-- Eating (Dine-in) -->
        <div class="kanban-box p-4">
            <div class="flex justify-between items-center mb-4 pb-2 border-b border-slate-800">
                <h3 class="font-bold text-xs text-indigo-400 flex items-center gap-1.5 uppercase"><i class="fa-solid fa-utensils"></i> 3. በመመገብ ላይ</h3>
                <span id="eatingBadge" class="bg-indigo-500/20 text-indigo-300 text-xs px-2.5 py-0.5 rounded-full font-bold">0</span>
            </div>
            <div class="space-y-3" id="colEating"></div>
        </div>

        <!-- Verify Payment -->
        <div class="kanban-box p-4 bg-[#142340]">
            <div class="flex justify-between items-center mb-4 pb-2 border-b border-slate-800">
                <h3 class="font-bold text-xs text-emerald-400 flex items-center gap-1.5 uppercase"><i class="fa-solid fa-receipt"></i> 4. ክፍያ ማረጋገጫ</h3>
                <span id="verifyBadge" class="bg-emerald-500/20 text-emerald-300 text-xs px-2.5 py-0.5 rounded-full font-bold">0</span>
            </div>
            <div class="space-y-3" id="colVerify"></div>
        </div>
    </div>

    <!-- Active Waiter Calls Alert -->
    <div class="mt-6 bg-slate-900/90 border border-slate-800 rounded-3xl p-5">
        <h3 class="text-sm font-bold text-rose-400 mb-3 flex items-center gap-2">
            <i class="fa-solid fa-bell animate-bounce"></i> የአስተናጋጅ ጥሪዎች (Sheet 3 Calls)
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3" id="activeCallsContainer"></div>
    </div>

    <script>
        const GOOGLE_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbw3VCGu6yzPlC5NG1qEw2wsbz_4IRtXzzaBio77t8vHU2afFsek-1qtXhpEdvk08HtF/exec";
        let localOrders = [];
        let localCalls = [];

        async function fetchStaffData() {
            try {
                const res = await fetch(`${GOOGLE_SCRIPT_URL}?action=getStaffData`);
                const data = await res.json();
                if (data.orders) localOrders = data.orders;
                if (data.calls) localCalls = data.calls;
                renderKanban();
                renderCalls();
                renderTableMatrix();
            } catch (e) {}
        }

        function renderKanban() {
            const colNew = document.getElementById('colNew');
            const colKitchen = document.getElementById('colKitchen');
            const colEating = document.getElementById('colEating');
            const colVerify = document.getElementById('colVerify');

            colNew.innerHTML = ''; colKitchen.innerHTML = ''; colEating.innerHTML = ''; colVerify.innerHTML = '';
            let cNew = 0, cPrep = 0, cEat = 0, cVer = 0;

            localOrders.forEach(ord => {
                if (ord.Order_Status === 'New') {
                    cNew++;
                    colNew.innerHTML += `
                        <div class="p-3.5 bg-slate-800/90 rounded-2xl border-l-4 border-sky-500 text-xs shadow-md">
                            <div class="flex justify-between font-bold text-white mb-1">
                                <span>ጠረጴዛ ${ord.Table_No}</span><span class="text-amber-400">#${ord.Order_ID}</span>
                            </div>
                            <p class="text-slate-300 mb-1">${ord.Items_Ordered}</p>
                            <button onclick="updateStatus('${ord.Order_ID}', 'Kitchen')" class="w-full py-2 bg-emerald-600 rounded-xl font-bold text-xs mt-2">ወደ ኪችን ላክ</button>
                        </div>`;
                } else if (ord.Order_Status === 'Kitchen') {
                    cPrep++;
                    colKitchen.innerHTML += `
                        <div class="p-3.5 bg-slate-800/90 rounded-2xl border-l-4 border-amber-500 text-xs shadow-md">
                            <div class="flex justify-between font-bold text-white mb-1">
                                <span>ጠረጴዛ ${ord.Table_No}</span><span class="text-amber-400">#${ord.Order_ID}</span>
                            </div>
                            <p class="text-slate-300 mb-2">${ord.Items_Ordered}</p>
                            <button onclick="updateStatus('${ord.Order_ID}', 'Served')" class="w-full py-2 bg-blue-600 rounded-xl font-bold text-xs">ደርሷል ➔ በመመገብ ላይ</button>
                        </div>`;
                } else if (ord.Order_Status === 'Served' && ord.Payment_Status !== 'Verification_Pending') {
                    cEat++;
                    colEating.innerHTML += `
                        <div class="p-3.5 bg-slate-800/90 rounded-2xl border-l-4 border-indigo-500 text-xs shadow-md">
                            <div class="flex justify-between font-bold text-white mb-1"><span>ጠረጴዛ ${ord.Table_No}</span><span class="text-amber-400">${ord.Total_Price}</span></div>
                            <p class="text-slate-400 text-[11px] mb-2">${ord.Items_Ordered}</p>
                            <span class="bg-indigo-950 text-indigo-300 text-[10px] px-2 py-0.5 rounded font-bold">ተመጋቢው ቁጭ ብሏል</span>
                        </div>`;
                } else if (ord.Payment_Status === 'Verification_Pending') {
                    cVer++;
                    colVerify.innerHTML += `
                        <div class="p-3.5 bg-slate-800 rounded-2xl border-2 border-emerald-500 text-xs shadow-lg animate-pulse">
                            <div class="flex justify-between font-bold text-white mb-1"><span>ጠረጴዛ ${ord.Table_No}</span><span class="text-emerald-400 font-bold">${ord.Total_Price}</span></div>
                            <p class="text-slate-300 text-[11px] mb-2">${ord.Payment_Method} ክፍያ ደርሷል</p>
                            <button onclick="confirmPayment('${ord.Order_ID}')" class="w-full py-2 bg-emerald-600 rounded-xl font-bold text-xs">ክፍያውን አረጋግጥና ዝጋ ✓</button>
                        </div>`;
                }
            });

            document.getElementById('newBadge').innerText = cNew;
            document.getElementById('prepBadge').innerText = cPrep;
            document.getElementById('eatingBadge').innerText = cEat;
            document.getElementById('verifyBadge').innerText = cVer;
        }

        function renderCalls() {
            const container = document.getElementById('activeCallsContainer');
            const activeCalls = localCalls.filter(c => c.Status === 'Active');
            if (activeCalls.length === 0) {
                container.innerHTML = `<p class="text-xs text-slate-500 col-span-3">ምንም ጥሪ የለም</p>`;
                return;
            }
            container.innerHTML = activeCalls.map(c => `
                <div class="p-3 bg-rose-950/50 border border-rose-600 text-xs rounded-2xl flex justify-between items-center">
                    <div><span class="font-black text-rose-300">ጠረጴዛ ${c.Table_No}</span><p class="text-slate-300">${c.Request_Type}</p></div>
                    <button onclick="dismissCall('${c.Call_ID}')" class="px-3 py-1.5 bg-rose-600 text-white rounded-xl font-bold text-[11px]">ጥሪውን አጥፋ</button>
                </div>`).join('');
        }

        function renderTableMatrix() {
            const matrix = document.getElementById('tableMatrix');
            matrix.innerHTML = '';
            for (let i = 1; i <= 12; i++) {
                const tNo = i < 10 ? '0' + i : '' + i;
                const hasVerify = localOrders.some(o => (o.Table_No == i || o.Table_No == tNo) && o.Payment_Status === 'Verification_Pending');
                const hasCall = localCalls.some(c => (c.Table_No == i || c.Table_No == tNo) && c.Status === 'Active');
                const isEating = localOrders.some(o => (o.Table_No == i || o.Table_No == tNo) && o.Order_Status === 'Served');

                let cls = 'bg-slate-900 border-slate-700 text-slate-400';
                if (hasCall) cls = 'bg-rose-950/60 border-rose-500 text-rose-300 animate-bounce';
                else if (hasVerify) cls = 'bg-emerald-950/60 border-emerald-500 text-emerald-300 animate-pulse';
                else if (isEating) cls = 'bg-indigo-950/60 border-indigo-500 text-indigo-300';

                matrix.innerHTML += `<div class="p-2 text-center rounded-xl text-xs font-bold border ${cls}">T-${tNo}</div>`;
            }
        }

        function updateStatus(orderId, status) {
            fetch(GOOGLE_SCRIPT_URL, {
                method: "POST", mode: "no-cors",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ action: "updateOrderStatus", orderId: orderId, orderStatus: status })
            });
            const o = localOrders.find(x => x.Order_ID === orderId);
            if (o) o.Order_Status = status;
            renderKanban();
        }

        function confirmPayment(orderId) {
            fetch(GOOGLE_SCRIPT_URL, {
                method: "POST", mode: "no-cors",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ action: "updateOrderStatus", orderId: orderId, orderStatus: "Paid", paymentStatus: "Paid" })
            });
            localOrders = localOrders.filter(x => x.Order_ID !== orderId);
            renderKanban();
            renderTableMatrix();
            Swal.fire({ icon: 'success', title: 'ክፍያው ተረጋግጧል!', timer: 1000, showConfirmButton: false });
        }

        function dismissCall(callId) {
            fetch(GOOGLE_SCRIPT_URL, {
                method: "POST", mode: "no-cors",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ action: "dismissCall", callId: callId })
            });
            const c = localCalls.find(x => x.Call_ID === callId);
            if (c) c.Status = "Completed";
            renderCalls();
            renderTableMatrix();
        }

        function playAlertSound() {
            try {
                const ctx = new (window.AudioContext || window.webkitAudioContext)();
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.connect(gain); gain.connect(ctx.destination);
                osc.frequency.setValueAtTime(659.25, ctx.currentTime);
                gain.gain.setValueAtTime(0.2, ctx.currentTime);
                osc.start(); osc.stop(ctx.currentTime + 0.4);
            } catch(e) {}
        }

        fetchStaffData();
        setInterval(fetchStaffData, 8000);
    </script>
</body>
</html>
